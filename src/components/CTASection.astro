---
interface Props {
  title?: string;
  text: string;
  buttonLabel: string;
  buttonHref: string;
  note?: string;
}
const { title, text, buttonLabel, buttonHref, note } = Astro.props;
---

<section class="cta-section section">
  <div class="container">
    <div class="cta-panel" data-reveal data-glow>
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-content">
        {title && <h2 class="cta-title">{title}</h2>}
        <p class="cta-text">{text}</p>
      </div>
      <div class="cta-action">
        <a href={buttonHref} class="btn btn-primary cta-button">{buttonLabel}</a>
        {note && <p class="cta-note">{note}</p>}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.75rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--color-bg-elevated), var(--color-bg-card));
  }
  .cta-glow {
    position: absolute;
    top: -60%;
    right: -10%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, var(--color-gold-glow) 0%, transparent 66%);
    pointer-events: none;
  }
  .cta-content { position: relative; z-index: 1; max-width: 46ch; }
  .cta-title {
    font-size: var(--fs-h2);
    margin-bottom: 0.6rem;
  }
  .cta-text {
    font-size: var(--fs-lead);
    color: var(--color-text-muted);
  }
  .cta-action {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .cta-button { position: relative; }
  .cta-note {
    font-size: 0.8rem;
    color: var(--color-text-faint);
    text-align: right;
    max-width: 34ch;
  }
  @media (max-width: 640px) {
    .cta-action { align-items: stretch; width: 100%; }
    .cta-button { width: 100%; }
    .cta-note { text-align: center; max-width: none; }
  }
</style>
