---
import { useTranslations, path, alternatePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
const year = new Date().getFullYear();

const navItems = [
  { id: 'services', label: t.nav.services },
  { id: 'process', label: t.nav.process },
  { id: 'references', label: t.nav.references },
  { id: 'about', label: t.nav.about },
  { id: 'contact', label: t.nav.contact },
] as const;

const deHref = alternatePath(pathname, 'de');
const enHref = alternatePath(pathname, 'en');
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={path('home', lang)} class="footer-logo" aria-label="Operiva — Start">
        <img src="/logo.png" alt="Operiva" width="48" height="48" />
        <span class="footer-name">Operiva</span>
      </a>
      <p class="footer-tagline">{t.footer.tagline}</p>
      <p class="footer-blurb">{t.footer.blurb}</p>
    </div>

    <nav class="footer-col" aria-label={t.footer.navTitle}>
      <h2 class="footer-title">{t.footer.navTitle}</h2>
      <ul>
        {navItems.map((item) => (
          <li><a href={path(item.id, lang)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t.footer.legalTitle}>
      <h2 class="footer-title">{t.footer.legalTitle}</h2>
      <ul>
        <li><a href={path('imprint', lang)}>{t.footer.imprint}</a></li>
        <li><a href={path('privacy', lang)}>{t.footer.privacy}</a></li>
      </ul>
    </nav>

    <div class="footer-col">
      <h2 class="footer-title">{t.footer.langTitle}</h2>
      <ul>
        <li><a href={deHref} class:list={{ active: lang === 'de' }} hreflang="de" lang="de">Deutsch</a></li>
        <li><a href={enHref} class:list={{ active: lang === 'en' }} hreflang="en" lang="en">English</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} Operiva. {t.footer.rights}</p>
    <p class="footer-ad">A&amp;D — Automations &amp; Designs</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    padding-top: clamp(3rem, 7vw, 4.5rem);
    padding-bottom: 2rem;
    margin-top: auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .footer-logo img { width: 48px; height: 48px; object-fit: contain; }
  .footer-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.25rem;
  }
  .footer-tagline {
    color: var(--color-gold);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 0.9rem;
  }
  .footer-blurb {
    margin-top: 0.6rem;
    max-width: 30ch;
    font-size: 0.95rem;
  }
  .footer-title {
    font-family: var(--font-head);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: 1rem;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-col a {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .footer-col a:hover,
  .footer-col a.active { color: var(--color-gold); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .footer-bottom p { font-size: 0.85rem; color: var(--color-text-faint); }
  .footer-ad { font-family: var(--font-head); letter-spacing: 0.06em; }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.5rem;
    }
    .footer-brand { grid-column: 1 / -1; }
  }
  /* mobil: größere Tap-Ziele + Platz, damit der fixe CTA-Balken
     den Footer-Abschluss nicht verdeckt (inkl. iPhone-Safe-Area) */
  @media (max-width: 900px) {
    .footer-col a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    .site-footer {
      padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (max-width: 420px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
