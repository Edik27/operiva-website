---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const pr = t.privacy;
---

<BaseLayout lang={lang} title={pr.title} description={pr.description}>
  <PageHero eyebrow={pr.eyebrow} h1={pr.h1} intro={pr.intro} />

  <section class="section legal">
    <div class="container container-narrow">
      <div class="legal-warning" role="note" data-reveal>
        <span class="warn-icon" aria-hidden="true">!</span>
        <p>{pr.warning}</p>
      </div>

      {pr.sections.map((section, i) => (
        <div class="legal-section" data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 40}ms`}>
          <h2 class="legal-h2">{section.title}</h2>
          {section.paragraphs.map((para) => <p class="legal-p">{para}</p>)}
          {section.items && (
            <ul class="legal-list">
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </div>
      ))}

      <p class="legal-updated" data-reveal>{pr.updated}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-warning {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
    border: 1px solid var(--color-gold);
    border-radius: var(--radius-sm);
    background: var(--color-gold-dim);
  }
  .warn-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-on-gold);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .legal-warning p { color: var(--color-text); font-size: 0.92rem; }

  .legal-section { margin-bottom: 2rem; }
  .legal-h2 {
    font-size: var(--fs-h3);
    margin-bottom: 0.75rem;
  }
  .legal-p { margin-bottom: 0.9rem; max-width: 68ch; }
  .legal-p:last-child { margin-bottom: 0; }
  .legal-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .legal-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--color-text-muted);
  }
  .legal-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
  }
  .legal-updated {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.85rem;
    color: var(--color-text-faint);
  }
</style>
