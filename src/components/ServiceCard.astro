---
interface Props {
  icon?: 'websites' | 'automation';
  title: string;
  text: string;
  href?: string;
  linkLabel?: string;
}
const { icon, title, text, href, linkLabel } = Astro.props;
---

<article class="service-card" data-reveal data-glow>
  {icon && (
    <span class="service-icon" aria-hidden="true">
      {icon === 'websites' ? (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <path d="M3 9h18" />
          <circle cx="6" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
          <circle cx="8.4" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
          <path class="web-line web-line-1" d="M6 13h9" style="--len: 9" />
          <path class="web-line web-line-2" d="M6 16.5h6" style="--len: 6" />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <g class="gear gear-a">
            <path d="M 13.90 9.00 L 15.44 10.44 L 14.57 12.54 L 12.46 12.46 L 12.54 14.57 L 10.44 15.44 L 9.00 13.90 L 7.56 15.44 L 5.46 14.57 L 5.54 12.46 L 3.43 12.54 L 2.56 10.44 L 4.10 9.00 L 2.56 7.56 L 3.43 5.46 L 5.54 5.54 L 5.46 3.43 L 7.56 2.56 L 9.00 4.10 L 10.44 2.56 L 12.54 3.43 L 12.46 5.54 L 14.57 5.46 L 15.44 7.56 Z" />
            <circle cx="9" cy="9" r="1.9" />
          </g>
          <g class="gear gear-b">
            <path d="M 20.10 16.00 L 21.45 17.25 L 20.52 19.17 L 18.71 18.89 L 18.57 20.72 L 16.49 21.20 L 15.58 19.61 L 14.06 20.64 L 12.39 19.31 L 13.07 17.61 L 11.31 17.07 L 11.31 14.93 L 13.07 14.39 L 12.39 12.69 L 14.06 11.36 L 15.58 12.39 L 16.49 10.80 L 18.57 11.28 L 18.71 13.11 L 20.52 12.83 L 21.45 14.75 Z" />
            <circle cx="16.4" cy="16" r="1.5" />
          </g>
        </svg>
      )}
    </span>
  )}
  <h3 class="service-title">{title}</h3>
  <p class="service-text">{text}</p>
  {href && linkLabel && (
    <a href={href} class="service-link">
      {linkLabel}
      <span aria-hidden="true" class="arrow">→</span>
    </a>
  )}
</article>

<style>
  .service-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: var(--shadow-card);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
    height: 100%;
  }
  .service-card:hover {
    border-color: var(--color-gold);
    transform: translateY(-4px);
  }
  .service-icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--color-gold-dim);
    color: var(--color-gold);
    margin-bottom: 1.25rem;
  }
  .service-icon svg { width: 26px; height: 26px; }

  /* Zahnräder drehen sich beim Hover über die Karte (gegenläufig) */
  .gear {
    transform-box: fill-box;
    transform-origin: center;
  }
  .service-card:hover .gear-a { animation: gear-spin 5s linear infinite; }
  .service-card:hover .gear-b { animation: gear-spin-rev 4.4s linear infinite; }
  @keyframes gear-spin {
    to { transform: rotate(360deg); }
  }
  @keyframes gear-spin-rev {
    to { transform: rotate(-360deg); }
  }
  /* Website-Icon: Inhaltszeilen "laden" beim Hover rein und wieder raus */
  .web-line {
    stroke-dasharray: var(--len);
    stroke-dashoffset: 0;
  }
  .service-card:hover .web-line-1 { animation: web-draw 1.9s ease-in-out infinite; }
  .service-card:hover .web-line-2 { animation: web-draw 1.9s ease-in-out 0.28s infinite; }
  @keyframes web-draw {
    0%, 100% { stroke-dashoffset: var(--len); }
    35%, 65% { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card:hover .gear-a,
    .service-card:hover .gear-b,
    .service-card:hover .web-line-1,
    .service-card:hover .web-line-2 { animation: none; }
  }
  .service-title {
    font-size: var(--fs-h3);
    margin-bottom: 0.75rem;
  }
  .service-text {
    font-size: 1rem;
    line-height: 1.6;
  }
  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--color-gold);
  }
  .service-link .arrow { transition: transform 0.25s var(--ease); }
  .service-link:hover .arrow { transform: translateX(4px); }
</style>
