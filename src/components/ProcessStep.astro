---
interface Props {
  number: number;
  label: string;
  title: string;
  text: string;
}
const { number, label, title, text } = Astro.props;
const num = String(number).padStart(2, '0');
---

<article class="process-step" data-reveal>
  <div class="step-index">
    <span class="step-num" data-step-num>{num}</span>
  </div>
  <div class="step-body">
    <span class="step-label">{label}</span>
    <h3 class="step-title">{title}</h3>
    <p class="step-text">{text}</p>
  </div>
</article>

<style>
  .process-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
  }
  .step-index {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .step-num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-card);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-gold);
    flex-shrink: 0;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  /* erreichter Schritt: sanfte goldene Füllung des Nummern-Kreises */
  .step-num.is-active {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-on-gold);
  }

  .step-body { padding-bottom: 2.75rem; }
  .step-label {
    font-family: var(--font-head);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .step-title {
    font-size: var(--fs-h3);
    margin: 0.4rem 0 0.6rem;
  }
  .step-text { max-width: 62ch; }

  @media (max-width: 520px) {
    .process-step { gap: 1rem; }
    .step-num { width: 48px; height: 48px; font-size: 1rem; }
  }
  /* reduzierte Bewegung: alle Kreise golden umrandet (kein Füll-Übergang) */
  @media (prefers-reduced-motion: reduce) {
    .step-num { border-color: var(--color-gold); }
  }
</style>
