---
interface Props {
  claim: string;
  h1: string;
  sub: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
}
const { claim, h1, sub, primaryLabel, primaryHref, secondaryLabel, secondaryHref } = Astro.props;

// Headline in Wörter zerlegen für gestaffeltes Reveal
const words = h1.split(' ');
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <canvas class="hero-particles" aria-hidden="true"></canvas>
  <div class="container hero-inner">
    <div class="hero-logo-wrap" data-reveal>
      <div class="hero-logo-glow" aria-hidden="true"></div>
      <div class="hero-logo-inner">
        <img class="hero-logo" src="/logo.png" alt="Operiva — A&D Animations & Designs" width="150" height="150" />
        <span class="hero-logo-shimmer" aria-hidden="true"></span>
      </div>
    </div>
    <p class="hero-claim" data-reveal style="--reveal-delay: 60ms">{claim}</p>
    <h1 class="hero-title">
      {words.map((w, i) => (
        <>
          <span class="word" data-reveal style={`--reveal-delay: ${140 + i * 55}ms`}>{w}</span>
          {' '}
        </>
      ))}
    </h1>
    <p class="hero-sub lead" data-reveal style="--reveal-delay: 340ms">{sub}</p>
    <div class="hero-actions" data-reveal style="--reveal-delay: 420ms">
      <a href={primaryHref} class="btn btn-primary">{primaryLabel}</a>
      <a href={secondaryHref} class="btn btn-secondary">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3.5rem, 8vw, 6rem);
    text-align: center;
  }
  /* großflächiger, sehr dezenter Gold-Schimmer im Hintergrund (atmet) */
  .hero-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: min(900px, 120vw);
    height: 900px;
    background: radial-gradient(
      circle at center,
      var(--color-gold-glow) 0%,
      rgba(212, 175, 90, 0.05) 32%,
      transparent 62%
    );
    pointer-events: none;
    z-index: 0;
    animation: hero-breathe 9s ease-in-out infinite;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-logo-wrap {
    position: relative;
    display: inline-grid;
    place-items: center;
    margin-bottom: 1.75rem;
  }
  .hero-logo-glow {
    position: absolute;
    inset: -22%;
    background: radial-gradient(circle, var(--color-gold-glow) 0%, transparent 68%);
    filter: blur(6px);
    z-index: 0;
    animation: logo-glow-breathe 9s ease-in-out infinite;
  }
  /* Logo + Shimmer schweben als eine Einheit (deckungsgleich, kein Versatz) */
  .hero-logo-inner {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    animation: logo-float 6s ease-in-out infinite;
  }
  .hero-logo {
    grid-area: 1 / 1;
    z-index: 1;
    width: clamp(110px, 20vw, 150px);
    height: auto;
    object-fit: contain;
  }
  /* Gold-Shimmer, per Maske exakt auf die Logo-Silhouette begrenzt */
  .hero-logo-shimmer {
    grid-area: 1 / 1;
    z-index: 2;
    width: clamp(110px, 20vw, 150px);
    height: clamp(110px, 20vw, 150px);
    pointer-events: none;
    background-image: linear-gradient(
      115deg,
      transparent 34%,
      rgba(255, 246, 224, 0.55) 47%,
      rgba(255, 255, 255, 0.25) 52%,
      transparent 66%
    );
    background-repeat: no-repeat;
    background-size: 250% 100%;
    background-position: 160% 0;
    -webkit-mask-image: url('/logo.png');
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
    -webkit-mask-size: contain;
    mask-image: url('/logo.png');
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
    mix-blend-mode: screen;
    animation: logo-shimmer 5s ease-in-out 1.2s infinite;
  }

  .hero-claim {
    font-family: var(--font-head);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1.5rem;
  }
  .hero-title {
    font-size: var(--fs-hero);
    max-width: 16ch;
    margin-inline: auto;
  }
  .hero-sub {
    max-width: 60ch;
    margin: 1.5rem auto 0;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 2.5rem;
  }
  @media (max-width: 480px) {
    .hero-actions { width: 100%; }
    .hero-actions .btn { flex: 1 1 100%; }
  }
</style>

<script>
  // Schwebende Gold-Partikel im Hero (leichtgewichtig, kein externes Skript).
  // Aus bei prefers-reduced-motion und pausiert, wenn der Hero nicht sichtbar ist.
  const canvas = document.querySelector('.hero-particles') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduce) {
    const ctx = canvas.getContext('2d');
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0, h = 0, raf = 0;
    type P = { x: number; y: number; r: number; vx: number; vy: number; a: number; tw: number; ph: number };
    let parts: P[] = [];

    const rand = (min: number, max: number) => Math.random() * (max - min) + min;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      w = canvas.width = Math.max(1, Math.floor(rect.width * DPR));
      h = canvas.height = Math.max(1, Math.floor(rect.height * DPR));
    };

    const make = (): P => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: rand(0.6, 2.1) * DPR,
      vx: rand(-0.12, 0.12) * DPR,
      vy: -rand(0.06, 0.3) * DPR,
      a: rand(0.15, 0.6),
      tw: rand(0.005, 0.025),
      ph: Math.random() * Math.PI * 2,
    });

    const init = () => {
      const rect = canvas.getBoundingClientRect();
      const count = Math.round(rect.width / 38);
      parts = Array.from({ length: Math.max(22, Math.min(42, count)) }, make);
    };

    const frame = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      for (const p of parts) {
        p.x += p.vx;
        p.y += p.vy;
        p.ph += p.tw;
        if (p.y < -12) { p.y = h + 12; p.x = Math.random() * w; }
        if (p.x < -12) p.x = w + 12;
        if (p.x > w + 12) p.x = -12;
        const alpha = p.a * (0.55 + 0.45 * Math.sin(p.ph));
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(212, 175, 90, ${alpha.toFixed(3)})`;
        ctx.fill();
      }
      raf = requestAnimationFrame(frame);
    };

    const start = () => { if (!raf) raf = requestAnimationFrame(frame); };
    const stop = () => { if (raf) { cancelAnimationFrame(raf); raf = 0; } };

    resize();
    init();
    start();

    window.addEventListener('resize', () => { resize(); init(); }, { passive: true });

    // Pausieren, wenn der Hero aus dem Viewport scrollt (spart CPU/Akku)
    const io = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { threshold: 0 }
    );
    io.observe(canvas);
  }
</script>
