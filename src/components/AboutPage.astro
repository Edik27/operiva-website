---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import CTASection from './CTASection.astro';
import { useTranslations, path, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const a = t.about;
---

<BaseLayout lang={lang} title={a.title} description={a.description}>
  <PageHero eyebrow={a.eyebrow} h1={a.h1} />

  <section class="section about-intro">
    <div class="container container-narrow">
      {a.paragraphs.map((para, i) => (
        <p class="about-para lead" data-reveal style={`--reveal-delay: ${i * 70}ms`}>{para}</p>
      ))}
    </div>
  </section>

  <section class="section about-values">
    <div class="container">
      <p class="eyebrow" data-reveal>{a.valuesTitle}</p>
      <div class="values-grid">
        {a.values.map((value, i) => (
          <div class="value-item" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="value-mark" aria-hidden="true"></span>
            <h3 class="value-title">{value.title}</h3>
            <p class="value-text">{value.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    text={a.cta.text}
    buttonLabel={a.cta.button}
    buttonHref={path('contact', lang)}
    note={t.common.trust}
  />
</BaseLayout>

<style>
  .about-intro { padding-bottom: 0; }
  .about-para { color: var(--color-text-muted); }
  .about-para + .about-para { margin-top: 1.5rem; }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .value-item { padding-top: 1.5rem; border-top: 1px solid var(--color-border-strong); }
  .value-mark {
    display: block;
    width: 32px;
    height: 3px;
    background: var(--color-gold);
    margin-bottom: 1.25rem;
    border-radius: 2px;
  }
  .value-title { font-size: var(--fs-h3); margin-bottom: 0.6rem; }
  .value-text { font-size: 1rem; }

  @media (max-width: 800px) {
    .values-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
