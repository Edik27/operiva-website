---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import CTASection from './CTASection.astro';
import { useTranslations, path, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const r = t.references;
---

<BaseLayout lang={lang} title={r.title} description={r.description}>
  <PageHero eyebrow={r.eyebrow} h1={r.h1} intro={r.intro} watermark />

  <section class="section">
    <div class="container">
      <div class="ref-placeholder" data-reveal>
        <span class="ref-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="14" rx="2" />
            <path d="m3 15 5-4 4 3 3-2 6 4" />
            <circle cx="8.5" cy="9" r="1.4" />
          </svg>
        </span>
        <p class="ref-text">{r.placeholder}</p>
      </div>
    </div>
  </section>

  <CTASection
    text={t.home.cta.text}
    buttonLabel={t.nav.cta}
    buttonHref={path('contact', lang)}
    note={t.common.trust}
  />
</BaseLayout>

<style>
  .ref-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: clamp(3rem, 8vw, 5rem);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg-card);
  }
  .ref-mark {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: var(--color-gold-dim);
    color: var(--color-gold);
  }
  .ref-mark svg { width: 32px; height: 32px; }
  .ref-text {
    font-family: var(--font-head);
    font-size: var(--fs-h3);
    color: var(--color-text-muted);
  }
</style>
