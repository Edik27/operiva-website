---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import CTASection from './CTASection.astro';
import { useTranslations, path, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const r = t.references;
const c = r.concepts;
---

<BaseLayout lang={lang} title={r.title} description={r.description}>
  <PageHero eyebrow={r.eyebrow} h1={r.h1} intro={r.intro} watermark />

  <section class="section" aria-labelledby="concepts-title">
    <div class="container">
      <header class="ref-head">
        <p class="eyebrow" data-reveal>{c.eyebrow}</p>
        <h2 id="concepts-title" data-reveal style="--reveal-delay: 60ms">{c.title}</h2>
        <p class="lead ref-head-intro" data-reveal style="--reveal-delay: 120ms">{c.intro}</p>
      </header>

      <ul class="ref-grid" role="list">
        {c.items.map((item, i) => (
          <li>
            <a
              class="ref-card"
              href={item.href}
              data-reveal
              data-glow
              style={`--reveal-delay: ${(i % 2) * 80}ms`}
            >
              <div class="browser">
                <div class="browser-bar" aria-hidden="true">
                  <span class="browser-dots"><span></span><span></span><span></span></span>
                </div>
                <div class="browser-shot">
                  <picture>
                    <source type="image/webp" srcset={item.img.replace(/\.jpg$/, '.webp')} />
                    <img
                      src={item.img}
                      alt={item.alt}
                      width="1200"
                      height="770"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </div>
              </div>

              <div class="ref-card-body">
                <span class="ref-badge">
                  <span class="ref-badge-dot" aria-hidden="true"></span>{c.badge}
                </span>
                <h3 class="ref-card-title">
                  {item.name}<span class="ref-card-industry"> · {item.industry}</span>
                </h3>
                <p class="ref-card-text">{item.text}</p>
                <span class="ref-card-link">
                  {c.demoLabel}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTASection
    text={r.cta.text}
    buttonLabel={r.cta.button}
    buttonHref={path('contact', lang)}
    note={t.common.trust}
  />
</BaseLayout>

<style>
  .ref-head {
    max-width: 60ch;
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }
  .ref-head h2 {
    font-size: var(--fs-h2);
    margin-top: 0.75rem;
  }
  .ref-head-intro {
    margin-top: 1rem;
  }

  .ref-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    list-style: none;
  }

  /* ---- Karte ---- */
  .ref-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(0.9rem, 1.6vw, 1.15rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-card);
    color: inherit;
    transition: border-color 0.3s var(--ease);
  }
  .ref-card:hover {
    border-color: var(--color-gold);
  }

  /* ---- Browser-Rahmen (dunkle Variante) ---- */
  .browser {
    border: 1px solid var(--color-border-strong);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg-elevated);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .ref-card:hover .browser {
    transform: translateY(-4px);
    box-shadow: 0 20px 44px -26px rgba(0, 0, 0, 0.75);
  }
  .browser-bar {
    display: flex;
    align-items: center;
    height: 34px;
    padding: 0 13px;
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border);
  }
  .browser-dots {
    display: inline-flex;
    gap: 6px;
  }
  .browser-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }
  .browser-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg);
  }
  .browser-shot picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .browser-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* ---- Text ---- */
  .ref-card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 1.3rem 0.55rem 0.5rem;
  }
  .ref-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    font-family: var(--font-head);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    padding: 0.3rem 0.68rem;
  }
  .ref-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
  }
  .ref-card-title {
    font-size: var(--fs-h3);
  }
  .ref-card-industry {
    color: var(--color-text-faint);
    font-weight: 400;
  }
  .ref-card-text {
    color: var(--color-text-muted);
  }
  .ref-card-link {
    margin-top: 0.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-head);
    font-size: 0.92rem;
    color: var(--color-gold);
  }
  .ref-card-link svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s var(--ease);
  }
  .ref-card:hover .ref-card-link svg {
    transform: translateX(4px);
  }

  @media (max-width: 760px) {
    .ref-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
