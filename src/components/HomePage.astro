---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import ServiceCard from './ServiceCard.astro';
import CTASection from './CTASection.astro';
import FAQ from './FAQ.astro';
import { useTranslations, path, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
---

<BaseLayout lang={lang} title={h.title} description={h.description} faq={h.faq.items}>
  <Hero
    claim={h.hero.claim}
    h1={h.hero.h1}
    sub={h.hero.sub}
    primaryLabel={h.hero.ctaPrimary}
    primaryHref={path('contact', lang)}
    secondaryLabel={h.hero.ctaSecondary}
    secondaryHref={path('services', lang)}
  />

  <!-- Leistungs-Teaser -->
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{h.teaser.eyebrow}</p>
      <div class="teaser-grid">
        <ServiceCard
          icon="websites"
          title={h.teaser.websitesTitle}
          text={h.teaser.websitesText}
          href={path('services', lang)}
          linkLabel={t.nav.services}
        />
        <ServiceCard
          icon="automation"
          title={h.teaser.automationTitle}
          text={h.teaser.automationText}
          href={path('services', lang)}
          linkLabel={t.nav.services}
        />
      </div>
    </div>
  </section>

  <!-- So arbeiten wir (Teaser) -->
  <section class="section process-teaser">
    <div class="process-fog" aria-hidden="true"></div>
    <div class="container">
      <div class="process-teaser-inner" data-reveal>
        <p class="eyebrow">{h.process.eyebrow}</p>
        <p class="lead process-teaser-text">{h.process.text}</p>
        <ol class="step-chips" aria-label={h.process.eyebrow}>
          {h.process.steps.map((step, i) => (
            <li
              class="step-chip"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms; --flow-delay: ${(i * 0.9).toFixed(2)}s`}
            >
              <span class="step-chip-num">{i + 1}</span>
              {step}
            </li>
          ))}
        </ol>
        <a href={path('process', lang)} class="process-teaser-link">
          {h.process.link}
          <span aria-hidden="true" class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Warum Operiva -->
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{h.why.eyebrow}</p>
      <div class="why-grid">
        {h.why.items.map((item, i) => (
          <div class="why-item" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="why-mark" aria-hidden="true"></span>
            <h3 class="why-title">{item.title}</h3>
            <p class="why-text">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQ eyebrow={h.faq.eyebrow} title={h.faq.title} items={h.faq.items} />

  <CTASection
    title={h.cta.title}
    text={h.cta.text}
    buttonLabel={h.cta.button}
    buttonHref={path('contact', lang)}
    note={t.common.trust}
  />
</BaseLayout>

<style>
  .teaser-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .process-teaser {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-elevated);
    border-block: 1px solid var(--color-border);
  }
  /* weiche Gold-Grundstimmung (dezentes Licht hinter dem Nebel) */
  .process-teaser::before {
    content: '';
    position: absolute;
    inset: -25%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(42% 55% at 22% 30%, rgba(212, 175, 90, 0.07), transparent 62%),
      radial-gradient(38% 50% at 80% 66%, rgba(212, 175, 90, 0.05), transparent 64%);
    filter: blur(48px);
    animation: mist-drift 30s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes mist-drift {
    0%   { transform: translate3d(-2%, -1%, 0) scale(1); }
    100% { transform: translate3d(2%, 2%, 0) scale(1.06); }
  }

  /* echte Nebelschwaden: goldene Rauschtextur, zwei gegenläufig driftende Schichten */
  .process-fog {
    position: absolute;
    inset: -10%;
    z-index: 0;
    pointer-events: none;
    /* weiche Auslauf-Maske: Nebel dichter in der Mitte, verläuft zu den Rändern */
    -webkit-mask: radial-gradient(72% 64% at 50% 45%, #000 20%, transparent 100%);
    mask: radial-gradient(72% 64% at 50% 45%, #000 20%, transparent 100%);
  }
  /* Zwei nahtlos gekachelte Nebelschichten; Drift über background-position
     => scharf & unabhängig von der Bildschirmbreite, nahtlose Endlos-Schleife */
  .process-fog::before,
  .process-fog::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/gold-mist.svg');
    background-repeat: repeat;
    /* etwas dunklere Nebelfarbe (brightness < 1) */
    filter: blur(4px) brightness(0.72);
    mix-blend-mode: screen;
    will-change: background-position;
  }
  .process-fog::before {
    background-size: 600px 360px;
    opacity: 0.34;
    animation: fog-a 38s linear infinite;
  }
  .process-fog::after {
    background-size: 820px 492px;
    opacity: 0.22;
    transform: rotate(7deg) scale(1.25);
    animation: fog-b 52s linear infinite;
  }
  /* Drift um exakt eine Kachel => nahtloser Loop */
  @keyframes fog-a {
    from { background-position: 0 0; }
    to   { background-position: 600px -360px; }
  }
  @keyframes fog-b {
    from { background-position: 0 0; }
    to   { background-position: -820px 492px; }
  }

  /* Inhalt über dem Nebel */
  .process-teaser .container { position: relative; z-index: 1; }
  .process-teaser-inner { max-width: var(--container-narrow); }
  .process-teaser-text { margin-top: 0.5rem; max-width: 58ch; }
  .step-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .step-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1rem 0.55rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 100px;
    font-family: var(--font-head);
    font-size: 0.9rem;
    color: var(--color-text);
    background: var(--color-bg-card);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }
  .step-chip:hover {
    transform: translateY(-3px);
    border-color: var(--color-gold);
    background: var(--color-bg-elevated);
  }
  .step-chip-num {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-gold-dim);
    color: var(--color-gold);
    font-size: 0.8rem;
    /* dezenter Gold-Puls, der 1→6 durch die Schritte wandert (impliziert den Ablauf) */
    animation: chip-flow 5s ease-in-out var(--flow-delay, 0s) infinite;
  }
  @keyframes chip-flow {
    0%, 18%, 100% {
      transform: scale(1);
      background: var(--color-gold-dim);
      color: var(--color-gold);
      box-shadow: 0 0 0 0 rgba(212, 175, 90, 0);
    }
    7% {
      transform: scale(1.16);
      background: var(--color-gold);
      color: var(--color-on-gold);
      box-shadow: 0 0 14px 1px var(--color-gold-glow);
    }
  }
  .process-teaser-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 2rem;
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--color-gold);
  }
  .process-teaser-link .arrow { transition: transform 0.25s var(--ease); }
  .process-teaser-link:hover .arrow { transform: translateX(4px); }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .why-item { padding-top: 1.5rem; border-top: 1px solid var(--color-border-strong); }
  .why-mark {
    display: block;
    width: 32px;
    height: 3px;
    background: var(--color-gold);
    margin-bottom: 1.25rem;
    border-radius: 2px;
  }
  .why-title { font-size: var(--fs-h3); margin-bottom: 0.6rem; }
  .why-text { font-size: 1rem; }

  @media (max-width: 800px) {
    .why-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 640px) {
    .teaser-grid { grid-template-columns: 1fr; }
  }
</style>
