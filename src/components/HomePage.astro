---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import ServiceCard from './ServiceCard.astro';
import CTASection from './CTASection.astro';
import FAQ from './FAQ.astro';
import { useTranslations, path, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
---

<BaseLayout lang={lang} title={h.title} description={h.description} faq={h.faq.items}>
  <Hero
    claim={h.hero.claim}
    h1={h.hero.h1}
    sub={h.hero.sub}
    primaryLabel={h.hero.ctaPrimary}
    primaryHref={path('contact', lang)}
    secondaryLabel={h.hero.ctaSecondary}
    secondaryHref={path('services', lang)}
  />

  <!-- Leistungs-Teaser -->
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{h.teaser.eyebrow}</p>
      <div class="teaser-grid">
        <ServiceCard
          icon="websites"
          title={h.teaser.websitesTitle}
          text={h.teaser.websitesText}
          note={h.teaser.websitesPrice}
          href={path('services', lang)}
          linkLabel={t.nav.services}
        />
        <ServiceCard
          icon="automation"
          title={h.teaser.automationTitle}
          text={h.teaser.automationText}
          href={path('services', lang)}
          linkLabel={t.nav.services}
        />
      </div>
    </div>
  </section>

  <!-- So arbeiten wir (Teaser) -->
  <section class="section process-teaser">
    <div class="process-stars" aria-hidden="true"></div>
    <div class="container">
      <div class="process-teaser-inner" data-reveal>
        <p class="eyebrow">{h.process.eyebrow}</p>
        <p class="lead process-teaser-text">{h.process.text}</p>
        <ol class="step-chips" aria-label={h.process.eyebrow}>
          {h.process.steps.map((step, i) => (
            <li
              class="step-chip"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms; --flow-delay: ${(i * 0.9).toFixed(2)}s`}
            >
              <span class="step-chip-num">{i + 1}</span>
              {step}
            </li>
          ))}
        </ol>
        <a href={path('process', lang)} class="process-teaser-link">
          {h.process.link}
          <span aria-hidden="true" class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Warum Operiva -->
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{h.why.eyebrow}</p>
      <div class="why-grid">
        {h.why.items.map((item, i) => (
          <div class="why-item" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="why-mark" aria-hidden="true"></span>
            <h3 class="why-title">{item.title}</h3>
            <p class="why-text">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQ eyebrow={h.faq.eyebrow} title={h.faq.title} items={h.faq.items} lang={lang} />

  <CTASection
    title={h.cta.title}
    text={h.cta.text}
    buttonLabel={h.cta.button}
    buttonHref={path('contact', lang)}
    note={t.common.trust}
  />
</BaseLayout>

<style>
  .teaser-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .process-teaser {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-elevated);
    border-block: 1px solid var(--color-border);
  }
  /* weiche Gold-Grundstimmung (dezentes Licht hinter dem Nebel) */
  .process-teaser::before {
    content: '';
    position: absolute;
    inset: -25%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(42% 55% at 22% 30%, rgba(212, 175, 90, 0.07), transparent 62%),
      radial-gradient(38% 50% at 80% 66%, rgba(212, 175, 90, 0.05), transparent 64%);
    filter: blur(48px);
    animation: mist-drift 30s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes mist-drift {
    0%   { transform: translate3d(-2%, -1%, 0) scale(1); }
    100% { transform: translate3d(2%, 2%, 0) scale(1.06); }
  }

  /* Animierter Sternenhimmel: drei versetzt funkelnde Ebenen (reines CSS).
     Warmweiß + Gold, dezent über dem Nebel; oben/unten weich ausgeblendet. */
  .process-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(1.5px 1.5px at 30px 40px, rgba(255, 246, 224, 0.85), transparent 60%),
      radial-gradient(1px 1px at 90px 20px, rgba(212, 175, 90, 0.75), transparent 60%),
      radial-gradient(1.5px 1.5px at 150px 90px, rgba(255, 246, 224, 0.7), transparent 60%),
      radial-gradient(1px 1px at 200px 50px, rgba(255, 246, 224, 0.6), transparent 60%),
      radial-gradient(1.5px 1.5px at 60px 140px, rgba(212, 175, 90, 0.7), transparent 60%),
      radial-gradient(1px 1px at 120px 185px, rgba(255, 246, 224, 0.75), transparent 60%),
      radial-gradient(2px 2px at 190px 160px, rgba(255, 246, 224, 0.85), transparent 60%),
      radial-gradient(1px 1px at 20px 205px, rgba(212, 175, 90, 0.6), transparent 60%);
    background-size: 220px 220px;
    background-repeat: repeat;
    animation: star-twinkle-a 4.5s ease-in-out infinite;
    -webkit-mask: linear-gradient(180deg, transparent, #000 16%, #000 84%, transparent);
    mask: linear-gradient(180deg, transparent, #000 16%, #000 84%, transparent);
  }
  .process-stars::before,
  .process-stars::after {
    content: '';
    position: absolute;
    inset: 0;
    background-repeat: repeat;
  }
  .process-stars::before {
    background-image:
      radial-gradient(1px 1px at 50px 60px, rgba(255, 246, 224, 0.7), transparent 60%),
      radial-gradient(1.5px 1.5px at 180px 30px, rgba(255, 246, 224, 0.85), transparent 60%),
      radial-gradient(1px 1px at 250px 120px, rgba(212, 175, 90, 0.7), transparent 60%),
      radial-gradient(1.5px 1.5px at 100px 150px, rgba(255, 246, 224, 0.75), transparent 60%),
      radial-gradient(1px 1px at 30px 220px, rgba(255, 246, 224, 0.6), transparent 60%),
      radial-gradient(2px 2px at 210px 240px, rgba(255, 246, 224, 0.8), transparent 60%),
      radial-gradient(1px 1px at 280px 200px, rgba(212, 175, 90, 0.6), transparent 60%);
    background-size: 300px 300px;
    animation: star-twinkle-b 5.5s ease-in-out 0.8s infinite;
  }
  .process-stars::after {
    background-image:
      radial-gradient(1px 1px at 80px 90px, rgba(255, 246, 224, 0.7), transparent 60%),
      radial-gradient(1.5px 1.5px at 320px 60px, rgba(255, 246, 224, 0.85), transparent 60%),
      radial-gradient(1px 1px at 200px 200px, rgba(212, 175, 90, 0.7), transparent 60%),
      radial-gradient(1.5px 1.5px at 40px 300px, rgba(255, 246, 224, 0.75), transparent 60%),
      radial-gradient(1px 1px at 350px 330px, rgba(255, 246, 224, 0.6), transparent 60%),
      radial-gradient(2px 2px at 150px 350px, rgba(255, 246, 224, 0.8), transparent 60%);
    background-size: 380px 380px;
    animation: star-twinkle-c 7s ease-in-out 1.6s infinite, star-drift 120s linear infinite;
  }
  @keyframes star-twinkle-a {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  @keyframes star-twinkle-b {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 0.4; }
  }
  @keyframes star-twinkle-c {
    0%, 100% { opacity: 0.7; }
    40% { opacity: 1; }
    75% { opacity: 0.45; }
  }
  /* langsame Aufwärts-Drift (nahtlos: exakt eine Kachelhöhe) */
  @keyframes star-drift {
    from { background-position: 0 0; }
    to { background-position: 0 -380px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .process-stars,
    .process-stars::before,
    .process-stars::after { animation: none; opacity: 0.85; }
  }

  /* Inhalt über dem Nebel */
  .process-teaser .container { position: relative; z-index: 1; }
  .process-teaser-inner { max-width: var(--container-narrow); }
  .process-teaser-text { margin-top: 0.5rem; max-width: 58ch; }
  .step-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .step-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1rem 0.55rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 100px;
    font-family: var(--font-head);
    font-size: 0.9rem;
    color: var(--color-text);
    background: var(--color-bg-card);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }
  .step-chip:hover {
    transform: translateY(-3px);
    border-color: var(--color-gold);
    background: var(--color-bg-elevated);
  }
  .step-chip-num {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-gold-dim);
    color: var(--color-gold);
    font-size: 0.8rem;
    /* dezenter Gold-Puls, der 1→6 durch die Schritte wandert (impliziert den Ablauf) */
    animation: chip-flow 5s ease-in-out var(--flow-delay, 0s) infinite;
  }
  @keyframes chip-flow {
    0%, 18%, 100% {
      transform: scale(1);
      background: var(--color-gold-dim);
      color: var(--color-gold);
      box-shadow: 0 0 0 0 rgba(212, 175, 90, 0);
    }
    7% {
      transform: scale(1.16);
      background: var(--color-gold);
      color: var(--color-on-gold);
      box-shadow: 0 0 14px 1px var(--color-gold-glow);
    }
  }
  .process-teaser-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 2rem;
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--color-gold);
  }
  .process-teaser-link .arrow { transition: transform 0.25s var(--ease); }
  .process-teaser-link:hover .arrow { transform: translateX(4px); }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .why-item { padding-top: 1.5rem; border-top: 1px solid var(--color-border-strong); }
  .why-mark {
    display: block;
    width: 32px;
    height: 3px;
    background: var(--color-gold);
    margin-bottom: 1.25rem;
    border-radius: 2px;
  }
  .why-title { font-size: var(--fs-h3); margin-bottom: 0.6rem; }
  .why-text { font-size: 1rem; }

  @media (max-width: 800px) {
    .why-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  /* Mobil: Phasen-Pills deterministisch 3 pro Reihe (2 Reihen à 3) */
  @media (max-width: 767px) {
    .step-chips {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
      /* verhindert übermäßig breite Pills auf großen Handys/kleinen Tablets */
      max-width: 30rem;
    }
    .step-chip {
      width: 100%;
      min-width: 0;
      justify-content: center;
      gap: 0.3rem;
      padding: 0.5rem 0.35rem;
      font-size: clamp(0.7rem, 3vw, 0.8rem);
      white-space: nowrap;
      hyphens: none;
    }
    .step-chip-num {
      flex: none;
      width: 20px;
      height: 20px;
      font-size: 0.7rem;
    }
  }
  @media (max-width: 640px) {
    .teaser-grid { grid-template-columns: 1fr; }
  }
</style>
