---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import ContactForm from './ContactForm.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.contact;
---

<BaseLayout lang={lang} title={c.title} description={c.description}>
  <PageHero eyebrow={c.eyebrow} h1={c.h1} intro={c.intro} />

  <section class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-main" data-reveal>
          <ContactForm lang={lang} />
        </div>

        <aside class="contact-aside" data-reveal style="--reveal-delay: 90ms">
          <div class="aside-card">
            <p class="aside-label">{c.alt.label}</p>
            <p class="aside-text">{c.alt.text}</p>
            <a class="aside-email" href={`mailto:${c.alt.email}`}>{c.alt.email}</a>
          </div>
          <p class="aside-trust">{t.common.trust}</p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .contact-aside {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .aside-card {
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-card);
  }
  .aside-label {
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }
  .aside-text { font-size: 0.95rem; margin-bottom: 0.6rem; }
  .aside-email {
    font-family: var(--font-head);
    font-size: 1.05rem;
    color: var(--color-gold);
    word-break: break-word;
  }
  .aside-email:hover { color: var(--color-gold-soft); }
  .aside-trust {
    font-size: 0.82rem;
    color: var(--color-text-faint);
    line-height: 1.6;
  }

  @media (max-width: 800px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-aside { position: static; order: -1; }
  }
</style>
