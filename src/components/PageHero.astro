---
interface Props {
  eyebrow?: string;
  h1: string;
  intro?: string;
}
const { eyebrow, h1, intro } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-glow" aria-hidden="true"></div>
  <div class="container page-hero-inner">
    {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
    <h1 class="page-hero-title" data-reveal style="--reveal-delay: 60ms">{h1}</h1>
    {intro && (
      <p class="lead page-hero-intro" data-reveal style="--reveal-delay: 130ms">{intro}</p>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--color-border);
  }
  /* dezenter Gold-Schimmer, oben links, klar zurückhaltend */
  .page-hero-glow {
    position: absolute;
    top: -40%;
    left: -8%;
    width: min(680px, 90vw);
    height: 680px;
    background: radial-gradient(circle at center, var(--color-gold-glow) 0%, transparent 60%);
    opacity: 0.7;
    pointer-events: none;
    z-index: 0;
  }
  .page-hero-inner {
    position: relative;
    z-index: 1;
  }
  .page-hero-title {
    font-size: var(--fs-h1);
    max-width: 20ch;
  }
  .page-hero-intro {
    margin-top: 1.25rem;
    max-width: 62ch;
  }
</style>
