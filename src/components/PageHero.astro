---
interface Props {
  eyebrow?: string;
  h1: string;
  intro?: string;
  watermark?: boolean;
}
const { eyebrow, h1, intro, watermark = false } = Astro.props;
---

<section class:list={['page-hero', { 'has-watermark': watermark }]} data-glow>
  <div class="page-hero-glow" aria-hidden="true"></div>
  {watermark && (
    <img
      class="page-hero-watermark"
      src="/logo.png"
      alt=""
      aria-hidden="true"
      width="560"
      height="560"
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="container page-hero-inner">
    {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
    <h1 class="page-hero-title" data-reveal style="--reveal-delay: 60ms">{h1}</h1>
    {intro && (
      <p class="lead page-hero-intro" data-reveal style="--reveal-delay: 130ms">{intro}</p>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--color-border);
  }
  /* dezenter Gold-Schimmer, oben links, klar zurückhaltend */
  .page-hero-glow {
    position: absolute;
    top: 0;
    left: -8%;
    width: min(680px, 90vw);
    /* nur der obere Bereich der Sektion — der Glow erreicht die Unterkante nie,
       daher kein harter Schnitt durch overflow:hidden */
    height: min(75%, 460px);
    background: radial-gradient(115% 90% at 32% 0%, var(--color-gold-glow) 0%, transparent 70%);
    opacity: 0.7;
    pointer-events: none;
    z-index: 0;
    /* löst sich weich auf, lange bevor die Sektionskante kommt
       (-webkit- zuerst als Safari/iOS-Fallback) */
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
  }
  .page-hero-inner {
    position: relative;
    z-index: 1;
  }

  /* etwas mehr Höhe, damit das Lorbeer-Wasserzeichen atmen kann */
  .page-hero.has-watermark {
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(2rem, 5vw, 3.5rem);
  }
  /* dezentes Marken-Wasserzeichen (Lorbeer): rechts, vertikal zentriert, statisch */
  .page-hero-watermark {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: clamp(-24px, 2vw, 56px);
    translate: 0 -50%;
    width: clamp(200px, 26vw, 360px);
    height: auto;
    opacity: 0.08;
    pointer-events: none;
    /* Lorbeerkranz oben/unten weich ausblenden, falls die Sektion ihn anschneidet */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 20%, #000 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 20%, #000 80%, transparent 100%);
  }
  @media (max-width: 700px) {
    .page-hero-watermark {
      width: clamp(170px, 42vw, 240px);
      right: -22px;
      opacity: 0.05;
    }
  }
  .page-hero-title {
    font-size: var(--fs-h1);
    max-width: 20ch;
  }
  .page-hero-intro {
    margin-top: 1.25rem;
    max-width: 62ch;
  }
</style>
