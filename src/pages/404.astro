---
import BaseLayout from '../layouts/BaseLayout.astro';
import { path } from '../i18n/utils';

// 404 wird für beliebige unbekannte Pfade ausgeliefert und kennt die Sprache
// nicht sicher → bewusst zweisprachig gehalten. Basis-Layout auf DE.
---
<BaseLayout
  lang="de"
  title="Seite nicht gefunden (404) | Operiva"
  description="Diese Seite existiert nicht."
>
  <section class="section notfound">
    <div class="container">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1 class="nf-title">Seite nicht gefunden</h1>
      <p class="lead nf-text">
        Diese Seite existiert nicht oder wurde verschoben.
      </p>
      <p class="nf-text-en" lang="en">
        This page doesn’t exist or has moved.
      </p>
      <div class="nf-actions">
        <a href={path('home', 'de')} class="btn btn-primary">Zur Startseite</a>
        <a href={path('home', 'en')} class="btn btn-secondary" lang="en">To homepage</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound { text-align: center; padding-block: clamp(4rem, 12vw, 8rem); }
  .nf-code {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(4rem, 18vw, 9rem);
    line-height: 1;
    color: var(--color-gold);
    opacity: 0.9;
  }
  .nf-title { font-size: var(--fs-h1); margin-top: 0.5rem; }
  .nf-text { max-width: 46ch; margin: 1.25rem auto 0; }
  .nf-text-en { color: var(--color-text-faint); margin-top: 0.25rem; }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 2.5rem;
  }
</style>
